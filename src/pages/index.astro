---
import Layout from "../layouts/Layout.astro";
import Personkort from "../components/Personkort.astro";

const url = "https://pbhqptcgtunejfwsunzi.supabase.co/rest/v1/medlemmer";

const options = {
  headers: {
    apikey:
      "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBiaHFwdGNndHVuZWpmd3N1bnppIiwicm9sZSI6ImFub24iLCJpYXQiOjE2Nzg1MjU3NjEsImV4cCI6MTk5NDEwMTc2MX0.qPLnnbV_2nDBjczEpGDt10lr3DQgCZ54roKiy0OZXL4",
  },
};

const response = await fetch(url, options);
const allePersoner = await response.json();
---

<Layout title="Medlmsliste">
  <nav>
    <button data-tro="alle" class="aktiv">Alle</button>
    <button data-tro=1>Ateister</button>
    <button data-tro=2>Muslimer</button>
    <button data-tro=3>Kristne</button>
    <button data-tro=4>Andre</button>
  </nav>
  <main>
    {
      allePersoner.map((person) => (
        <Personkort
          link={"/personer/" + person.id}
          profilbillede={`/thumbs/${person.billede}`}
          navn={person.navn}
          email={person.email}
          tro={person.tro}
          dato={person.created_at.slice(0, 10)}
        />
      ))
    }
  </main>
</Layout>

<script>
  const knapper = document.querySelectorAll("button");
  const kort = document.querySelectorAll(".kort");
  knapper.forEach(knap=>knap.addEventListener("click", filtrer));

  function filtrer(){
    document.querySelector(".aktiv").classList.remove("aktiv");
    this.classList.add("aktiv");
    kort.forEach(elm=>{
      if(elm.dataset.tro == this.dataset.tro || this.dataset.tro == "alle"){
        elm.classList.remove("gem");
      }else{
        elm.classList.add("gem");
      }
    })
  }
</script>

<style>
  main {
    padding: 1em;
    display: grid;
    gap: 1em;
  }

  nav{
    padding: 1em;
  }

  .aktiv{
    color: orange;
  }

  @media screen and (min-width: 600px) {
    main {
      grid-template-columns: repeat(auto-fit, 350px);
      justify-content: center;
    }
  }
</style>
